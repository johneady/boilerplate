# Variables for the LOCAL docker-compose.yml stack only.
#
# Copy to .env.docker (gitignored) and always pass it explicitly:
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build -d
#
# WHY THIS FILE EXISTS
#
# Compose's default variable file is the project-root .env -- which here is the
# APPLICATION's own Laravel .env. A bare `docker compose up` therefore
# interpolates your development values into this throwaway stack without
# saying so: APP_PORT, APP_URL and anything else sharing a name are quietly
# taken from it.
#
# DOCKER_LOCAL_STACK is a tripwire for exactly that. docker-compose.yml
# declares it with no default, so forgetting --env-file fails immediately with
# a named error instead of booting a stack built from the wrong values. The
# variable is otherwise unused; the failure is the entire point.
DOCKER_LOCAL_STACK=1

# The port the local stack publishes. 8010 is the host dev server, so this
# stack defaults to 8011 and the two can run side by side.
APP_PORT=8011
