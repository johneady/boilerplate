APP_NAME=Boilerplate
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Needed when running behind a reverse proxy (see README "Trusted proxies");
# '*' is acceptable only while the container ports stay unpublished.
# TRUST_PROXIES=*

# A stable secret used to derive WebAuthn user handles for passkeys.
# PASSKEYS_USER_HANDLE_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# 'daily' rather than 'single': the log file is rotated and only
# LOG_DAILY_DAYS of them are kept. A 'single' file grows without bound, which
# in a container means it grows until the disk does.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Jobs only run when a worker is running. `composer run dev` starts one
# (queue:listen); otherwise run `php artisan queue:work` yourself, or set this
# to 'sync' to run jobs inline in the dispatching process while developing.
QUEUE_CONNECTION=database
# DB_QUEUE_RETRY_AFTER must stay ABOVE App\Jobs\Job::$timeout (60s), or a job
# still running when it elapses is handed to a second worker and runs twice.
# DB_QUEUE_RETRY_AFTER=90

# A queued job that exhausts its retries emails the "Failure alert address"
# in Admin -> Settings -> Email, if one is set. Failures arrive in bursts, so
# at most one alert per job class is sent per window below; 0 disables the
# throttle and alerts on every failure.
# QUEUE_FAILURE_ALERT_THROTTLE_MINUTES=15

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Consulted only when a driver above is set to 'redis'. The defaults here are
# Laravel's own and reach a Redis on localhost; nothing connects while
# CACHE_STORE, QUEUE_CONNECTION and SESSION_DRIVER stay on 'database'.
#
# The phpredis extension is in the DOCKER IMAGE only, so inside the container
# stack switching a driver is an env change plus a running Redis -- no image
# rebuild. Both compose files ship a commented-out service to uncomment.
#
# Running the app NATIVELY (composer run dev) is the exception: this machine's
# own PHP has no Redis client, and flipping a driver there fails immediately
# with 'Class "Redis" not found'. Install one first -- `pecl install redis`
# (matching the image) or `composer require predis/predis` (pure PHP, no
# extension) with REDIS_CLIENT=predis -- or trial Redis through the compose
# stack, which already has it.
#
# Worth knowing what moving off 'database' changes: app:prune-expired-storage
# exists only because the database cache and session stores never delete their
# own expired rows. Redis expires keys itself, so that command becomes a no-op
# for whichever stores you move (it already skips any store that is not
# 'database') -- leave it scheduled, since a mixed setup is normal.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Bind the dev servers to a non-loopback interface (e.g. 0.0.0.0 or a LAN/Tailscale IP)
# to reach `composer run dev` from another machine. VITE_HMR_HOST is the address the
# browser uses to reach Vite; it defaults to VITE_HOST, so set it when VITE_HOST=0.0.0.0.
# SERVER_HOST=0.0.0.0
# VITE_HOST=0.0.0.0
# VITE_HMR_HOST=192.168.1.62
