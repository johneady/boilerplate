# Production-shaped environment.
#
# The companion to .env.example, which is deliberately LOCAL-shaped -- sqlite,
# APP_DEBUG=true, MAIL_MAILER=log -- because that is what a developer wants on
# a fresh clone. Copying it onto a server and editing the handful of values
# that look wrong is how a production instance ends up with debug output on a
# public page, or a mailer that silently writes customer mail to a log file.
#
# This file inverts every one of those defaults, so the risk of a forgotten
# edit points the safe way. Fill in the blanks and deploy it.
#
# Run `php artisan app:check-production` once it is in place: it fails on the
# combinations that are individually valid and dangerous together, which no
# example file can prevent on its own.
#
# On Dokploy none of this is needed -- docker-compose.dokploy.yml sets these
# values as service environment entries. This file is for a deploy that is not
# using that compose file.

APP_NAME="Your App"
APP_ENV=production
# Generate with `php artisan key:generate --show`. An app booted without one
# cannot decrypt sessions or cookies.
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

# Required behind a TLS-terminating proxy (Traefik, a load balancer, Cloudflare)
# or every generated URL comes out as http:// on an https:// page and the
# browser blocks the CSS and JS as mixed content.
#
# '*' trusts whichever proxy forwarded the request. That is safe ONLY while the
# container's ports are unpublished, so nothing but the proxy can reach it. On a
# host where the app port is reachable directly, name the proxy addresses
# instead -- a comma-separated list -- because '*' there lets any client spoof
# its own IP and scheme. See config/trustedproxy.php.
TRUST_PROXIES=*

# A stable secret deriving WebAuthn user handles. CHANGING IT INVALIDATES EVERY
# REGISTERED PASSKEY, so generate it once, before the first user enrolls, and
# keep it with the backups.
PASSKEYS_USER_HANDLE_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# 'daily' with a retention count, never 'single': nothing rotates a log inside
# a container, so a single file grows until it fills the disk.
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# 'debug' here would write request payloads to disk on a live site.
LOG_LEVEL=warning

# sqlite is the local default and is wrong here: the queue, cache and sessions
# all run on this connection, so it becomes the busiest part of the stack and
# needs a server that handles concurrent writers.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Encrypts the session payload at rest, so a database backup or a dump does not
# hand over live sessions. Note that a changed APP_KEY then logs every user out.
SESSION_ENCRYPT=true
SESSION_PATH=/
# Leave null unless sessions must be shared across subdomains.
SESSION_DOMAIN=null
# Refuses to send the session cookie over plain HTTP. Safe once the site is
# https-only, which it should be.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log

# 'local' serves uploads from the container's own disk, which a redeploy
# replaces -- every avatar and uploaded image is lost unless the path is on a
# mounted volume. 's3' keeps them outside the container's lifecycle.
FILESYSTEM_DISK=local

# Jobs need a worker process. In the Docker stack that is CONTAINER_ROLE=worker;
# on a bare host it is a supervisor-managed `php artisan queue:work`. With no
# worker running, queued mail and image processing never happen at all.
QUEUE_CONNECTION=database
# Must stay ABOVE App\Jobs\Job::$timeout (60s) or a long job is handed to a
# second worker while the first is still running, and runs twice.
DB_QUEUE_RETRY_AFTER=90
# Address alerts land at is set in Admin -> Settings -> Email, not here.
QUEUE_FAILURE_ALERT_THROTTLE_MINUTES=15

CACHE_STORE=database

# 'log' writes mail to the log file instead of sending it -- the local default,
# and a silent failure in production. Point this at a real transport.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Consulted only when a driver above is set to 'redis'. The database drivers
# are the default and need no extra service; Redis is worth moving to once the
# queue or session volume makes the database the bottleneck. The image already
# carries phpredis, so it is an env change and a redeploy.
#
# Set a password and keep the instance off the public internet: an unprotected
# Redis holding sessions is a session-hijacking hole.
# REDIS_CLIENT=phpredis
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Only needed with FILESYSTEM_DISK=s3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Seconds a worker may go without completing a job before /health reports the
# queue degraded. See config/health.php.
HEALTH_QUEUE_HEARTBEAT_MAX_AGE=7200

VITE_APP_NAME="${APP_NAME}"
