<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         defaultTestSuite="Unit,Feature,Browser"
         enforceTimeLimit="true"
         defaultTimeLimit="60"
         failOnRisky="true"
>
    <!--
        No test takes more than a few seconds, so one that runs for a minute is
        stuck: most often a browser test whose Playwright server went away,
        which pest-plugin-browser waits on forever at 100% CPU. The limit turns
        that hang into a failure (a timed-out test is reported as risky, and
        risky tests fail the run). Enforced only where ext-pcntl is loaded.
    -->
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Browser">
            <directory>tests/Browser</directory>
        </testsuite>
        <!--
            Real calls to the Stripe and PayPal sandboxes. Not part of the
            default run: run the Sandbox test suite explicitly, with the
            STRIPE_SANDBOX_SECRET / PAYPAL_SANDBOX_CLIENT_ID and
            PAYPAL_SANDBOX_CLIENT_SECRET environment variables set (each
            gateway's tests skip without its credentials).
        -->
        <testsuite name="Sandbox">
            <directory>tests/Sandbox</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
